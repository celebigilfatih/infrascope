# Database
DATABASE_URL="postgresql://infrascope:infrascope-dev@localhost:5434/infrascope?schema=public"

# TLS
# Use local CA certificate paths for self-signed devices.
FORTIANALYZER_TLS_CA_CERT_PATH=
FORTIGATE_TLS_CA_CERT_PATH=
VMWARE_TLS_CA_CERT_PATH=

# Development-only escape hatch for local labs. Forbidden in production.
FORTIANALYZER_TLS_INSECURE=false
FORTIGATE_TLS_INSECURE=false
VMWARE_TLS_INSECURE=false

# Next.js
NEXT_PUBLIC_API_URL="http://localhost:3169"
NODE_ENV="development"

# Application
APP_NAME="InfraScope"
APP_VERSION="1.0.0"

# Optional: WebSocket configuration
NEXT_PUBLIC_WS_URL="ws://localhost:3169"

# Logging
LOG_LEVEL="debug"
