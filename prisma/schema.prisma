// ============================================================================
// ALARM MANAGEMENT SYSTEM
// ============================================================================

/// Alarm rule definition
model AlarmDefinition {
  id              String        @id @default(cuid())
  code            String        @unique  // e.g. "FW_POLICY_CHANGED"
  name            String
  description     String?
  category        AlarmCategory
  severity        AlarmSeverity2
  enabled         Boolean       @default(true)
  detectionLogic  Json          // {logtype, filter, threshold, timeWindowMinutes}
  source          String?        @map("source")  // 'fortianalyzer', 'fortigate-sslvpn', 'vmware'
  cooldownMinutes Int           @default(15)
  notifyEmail     Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  alarmEvents     AlarmEvent[]

  @@map("alarm_definitions")
}

/// Alarm event instance
model AlarmEvent {
  id              String            @id @default(cuid())
  alarmId         String
  severity        AlarmSeverity2
  title           String
  message         String
  rawData         Json?
  sourceIp        String?
  destIp          String?
  deviceName      String?
  acknowledged    Boolean           @default(false)
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  notifiedAt      DateTime?
  notifyChannel   String?           // "email"
  createdAt       DateTime          @default(now())
  alarm           AlarmDefinition   @relation(fields: [alarmId], references: [id])
  dlqEntries      NotificationDLQ[]

  @@index([alarmId])
  @@index([createdAt])
  @@index([severity])
  @@map("alarm_events")
}

/// Alarm check log for monitoring
model AlarmCheckLog {
  id             String   @id @default(cuid())
  checkTime      DateTime
  totalAlarms    Int
  triggeredCount Int
  errorCount     Int
  durationMs     Int
  status         String   // "RUNNING", "SUCCESS", "PARTIAL", "FAILED", "ORPHANED"
  createdAt      DateTime @default(now())

  @@index([checkTime])
  @@index([status])
  @@map("alarm_check_logs")
}

/// Cached FortiAnalyzer events for fast alarm evaluation
model CachedEvent {
  id          String   @id @default(cuid())
  logtype     String   // event, dns, traffic, webfilter, app-ctrl, attack, virus
  logId       String   // Original FortiAnalyzer log ID
  eventTime   DateTime // When the event occurred
  srcIp       String?
  dstIp       String?
  srcPort     Int?
  dstPort     Int?
  proto       Int?
  user        String?
  action      String?
  level       String?
  subtype     String?
  vdom        String?
  devname     String?
  policyid    Int?
  service     String?
  app         String?
  appcat      String?
  apprisk     String?
  srccountry  String?
  dstcountry  String?
  msg         String?
  rawLog      Json     // Complete original log entry
  createdAt   DateTime @default(now())

  @@unique([logtype, logId])
  @@index([logtype, eventTime])
  @@index([eventTime])
  @@index([logtype, srcIp, eventTime])
  @@index([logtype, dstIp, eventTime])
  @@map("cached_events")
}

/// Notification channel configuration
model NotificationConfig {
  id          String   @id @default(cuid())
  channel     String   // "email", "telegram"
  enabled     Boolean  @default(true)
  config      Json     // {smtpHost, smtpPort, smtpUser, smtpPass, recipients[]}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([channel])
  @@map("notification_configs")
}

enum AlarmCategory {
  CONFIG_ACCESS
  SECURITY
  RISK_ANOMALY
  OPERATIONAL
  SOC_CORRELATION
}

/// Using AlarmSeverity2 to avoid conflict with existing AlertSeverity
enum AlarmSeverity2 {
  ALARM_CRITICAL
  ALARM_HIGH
  ALARM_MEDIUM
  ALARM_LOW
  ALARM_INFO
}

/// System configuration key-value store for scheduler heartbeat, feature flags, etc.
model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON-serialized value
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("system_configs")
}

/// Notification Dead-Letter Queue for failed email/notification retries
/// Failed notifications are queued here with exponential backoff retry.
model NotificationDLQ {
  id           String    @id @default(cuid())
  alarmEventId String    // FK to AlarmEvent
  channel      String    // "email", "slack", "webhook"
  payload      Json      // Full notification payload (alarmCode, title, message, etc.)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5)
  lastAttempt  DateTime?
  nextRetry    DateTime  // Exponential backoff: 1m, 5m, 30m, 2h, 12h
  lastError    String?
  status       String    @default("pending") // "pending", "delivered", "failed_permanent"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  alarmEvent   AlarmEvent @relation(fields: [alarmEventId], references: [id])

  @@index([status, nextRetry])
  @@index([alarmEventId])
  @@map("notification_dlq")
}

/// Alarm Whitelist for suppressing false positives
model AlarmWhitelist {
  id          String   @id @default(cuid())
  alarmCode   String   // e.g. "DNS_TUNNEL_SUSPECT"
  field       String   // "sourceIp", "destIp", "user", "hostname"
  value       String   // The value to match (e.g. "10.5.2.1")
  reason      String?  // Why this is whitelisted
  createdBy   String   // User who added it
  expiresAt   DateTime? // Optional expiration
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([alarmCode, field, value])
  @@index([alarmCode, enabled])
  @@map("alarm_whitelist")
}

// ============================================================================
// NMS / SNMP INTEGRATION TABLES
// ============================================================================

/// Current SNMP interface state per device (upserted every poll cycle)
model NmsInterface {
  id             String   @id @default(cuid())
  nmsDeviceId    Int      @map("nms_device_id")
  device         Device   @relation(fields: [nmsDeviceId], references: [nmsDeviceId], onDelete: Cascade)
  interfaceIndex Int      @map("interface_index")
  interfaceName  String   @map("interface_name")
  description    String?
  adminStatus    String   @map("admin_status")   // "up" | "down"
  operStatus     String   @map("oper_status")    // "up" | "down"
  downSince      DateTime? @map("down_since")    // When port went down (for duration-based alarm filtering)
  operUpSince    DateTime? @map("oper_up_since")  // Last time port was seen up (NULL = never; skips NMS_PORT_DOWN alarm)
  monitored      Boolean  @default(false)          // Only monitored ports generate NMS_PORT_DOWN alarms
  speed          BigInt   @default(0)
  inOctets       BigInt   @default(0) @map("in_octets")
  outOctets      BigInt   @default(0) @map("out_octets")
  inErrors       Int      @default(0) @map("in_errors")
  outErrors      Int      @default(0) @map("out_errors")
  mtu            Int      @default(1500)
  lastPolledAt   DateTime @map("last_polled_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([nmsDeviceId, interfaceIndex])
  @@index([nmsDeviceId])
  @@index([adminStatus, operStatus])
  @@map("nms_interfaces")
}

/// SNMP health metrics time series (CPU, memory, temperature, uptime)
model NmsHealthMetric {
  id            String   @id @default(cuid())
  nmsDeviceId   Int      @map("nms_device_id")
  device        Device   @relation(fields: [nmsDeviceId], references: [nmsDeviceId], onDelete: Cascade)
  uptimeSeconds Int?     @map("uptime_seconds")
  cpuUsage      Float?   @map("cpu_usage")
  memoryUsage   Float?   @map("memory_usage")
  temperature   Float?
  collectedAt   DateTime @map("collected_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([nmsDeviceId, collectedAt])
  @@index([collectedAt])
  @@map("nms_health_metrics")
}

/// SNMP topology links discovered via LLDP/CDP
model NmsTopologyLink {
  id               String   @id @default(cuid())
  nmsDeviceId      Int      @map("nms_device_id")
  device           Device   @relation(fields: [nmsDeviceId], references: [nmsDeviceId], onDelete: Cascade)
  localInterface   String   @map("local_interface")
  remoteDeviceName String   @map("remote_device_name")
  remoteInterface  String   @map("remote_interface")
  protocol         String   @default("lldp")  // "lldp" | "cdp"
  lastSeenAt       DateTime @default(now()) @map("last_seen_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([nmsDeviceId, localInterface, remoteDeviceName])
  @@index([nmsDeviceId])
  @@map("nms_topology_links")
}

/// Network discovery scan job
model NmsDiscoveryScan {
  id             String   @id @default(cuid())
  cidr           String
  status         String   @default("pending")  // pending | running | completed | failed
  totalHosts     Int      @default(0) @map("total_hosts")
  processedHosts Int      @default(0) @map("processed_hosts")
  foundDevices   Int      @default(0) @map("found_devices")
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  discoveredDevices NmsDiscoveredDevice[]

  @@index([status])
  @@index([createdAt])
  @@map("nms_discovery_scans")
}

/// Devices found during a discovery scan (pending import approval)
model NmsDiscoveredDevice {
  id            String   @id @default(cuid())
  scanId        String   @map("scan_id")
  scan          NmsDiscoveryScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  ipAddress     String   @map("ip_address")
  hostname      String?
  vendor        String   @default("Generic")
  snmpCommunity String?  @map("snmp_community")
  sysDescr      String?  @map("sys_descr")
  snmpStatus    String   @default("none") @map("snmp_status")  // success | failed | none
  sshStatus     String   @default("none") @map("ssh_status")   // success | failed | open | closed | none
  imported      Boolean  @default(false)
  importedAt    DateTime? @map("imported_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([scanId, ipAddress])
  @@index([scanId])
  @@index([ipAddress])
  @@map("nms_discovered_devices")
}

/// Generic device metric time series (CPU, memory, temperature, bandwidth — one row per metric per poll)
model NmsDeviceMetric {
  id                String   @id @default(cuid())
  nmsDeviceId       Int      @map("nms_device_id")
  device            Device   @relation(fields: [nmsDeviceId], references: [nmsDeviceId], onDelete: Cascade)
  metricType        String   @map("metric_type")         // "cpu" | "memory" | "temperature" | ...
  metricName        String?  @map("metric_name")
  metricValue       Decimal? @map("metric_value")         @db.Decimal(10,2)
  metricUnit        String?  @map("metric_unit")
  thresholdWarning  Decimal? @map("threshold_warning")    @db.Decimal(10,2)
  thresholdCritical Decimal? @map("threshold_critical")   @db.Decimal(10,2)
  status            String?                               // "ok" | "warning" | "critical"
  collectedAt       DateTime @default(now()) @map("collected_at")

  @@index([nmsDeviceId, collectedAt])
  @@index([metricType])
  @@index([collectedAt])
  @@map("nms_device_metrics")
}

/// Interface-level bandwidth / error metrics time series
model NmsInterfaceMetric {
  id             String   @id @default(cuid())
  nmsDeviceId    Int      @map("nms_device_id")
  device         Device   @relation(fields: [nmsDeviceId], references: [nmsDeviceId], onDelete: Cascade)
  interfaceIndex Int      @map("interface_index")
  interfaceName  String?  @map("interface_name")
  description    String?
  adminStatus    String?  @map("admin_status")   // "up" | "down"
  operStatus     String?  @map("oper_status")    // "up" | "down"
  speed          BigInt?                          // bps
  inOctets       BigInt?  @map("in_octets")
  outOctets      BigInt?  @map("out_octets")
  collectedAt    DateTime @default(now()) @map("collected_at")

  @@index([nmsDeviceId, interfaceIndex, collectedAt])
  @@index([collectedAt])
  @@map("nms_interface_metrics")
}

/// Configuration backup stored from a device via SSH
model NmsBackup {
  id            String   @id @default(cuid())
  nmsDeviceId   Int      @map("nms_device_id")
  device        Device   @relation(fields: [nmsDeviceId], references: [nmsDeviceId], onDelete: Cascade)
  backupType    String   @default("config") @map("backup_type") // "Running Config" | "Startup Config"
  backupFile    String?  @map("backup_file")
  description   String?
  sizeBytes     BigInt   @default(0) @map("size_bytes")
  checksum      String?
  configuration String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([nmsDeviceId])
  @@index([createdAt])
  @@map("nms_backups")
}
