# Database
DATABASE_URL="postgresql://user:password@localhost:5432/infrascope?schema=public"

# TLS Configuration
# Use CA certificate paths for self-signed infrastructure certificates.
# Never use NODE_TLS_REJECT_UNAUTHORIZED=0 in production.
FORTIANALYZER_TLS_CA_CERT_PATH=
FORTIGATE_TLS_CA_CERT_PATH=
VMWARE_TLS_CA_CERT_PATH=

# Development-only escape hatch for local labs. Forbidden in production.
FORTIANALYZER_TLS_INSECURE=false
FORTIGATE_TLS_INSECURE=false
VMWARE_TLS_INSECURE=false

# Next.js
NEXT_PUBLIC_API_URL="http://localhost:3000"
NODE_ENV="development"

# Application
APP_NAME="InfraScope"
APP_VERSION="1.0.0"

# Optional: WebSocket configuration
NEXT_PUBLIC_WS_URL="ws://localhost:3000"

# Logging
LOG_LEVEL="info"

# NMS Integration (Network Monitoring System backend)
# External port exposed by NMS docker-compose (4001 → 3001 internal)
NMS_BACKEND_URL="http://localhost:4001"
