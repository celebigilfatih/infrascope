# Database
DATABASE_URL="postgresql://user:password@localhost:5432/infrascope?schema=public"

# TLS Configuration
# Use CA certificate paths for self-signed infrastructure certificates.
# Never use NODE_TLS_REJECT_UNAUTHORIZED=0 in production.
FORTIANALYZER_TLS_CA_CERT_PATH=
FORTIGATE_TLS_CA_CERT_PATH=
VMWARE_TLS_CA_CERT_PATH=

# Development-only escape hatch for local labs. Forbidden in production.
FORTIANALYZER_TLS_INSECURE=false
FORTIGATE_TLS_INSECURE=false
VMWARE_TLS_INSECURE=false

# Legacy direct FortiGate writes are disabled until the approval workflow is available.
FORTIGATE_LEGACY_WRITES_ENABLED=false
# REST request timeout in milliseconds. Read-only GET requests may retry; writes never do.
FORTIGATE_REQUEST_TIMEOUT_MS=15000

# 32-byte base64 or 64-character hex key for FortiGate/FortiAnalyzer credentials.
# Customer install.sh generates this automatically. NEXTAUTH_SECRET is used as
# a backward-compatible derivation source only when this value is empty.
INTEGRATION_CREDENTIALS_KEY=
# Temporary only during controlled key rotation; remove after re-encryption.
INTEGRATION_CREDENTIALS_PREVIOUS_KEY=
NMS_INTERNAL_TOKEN=

# Next.js
NEXT_PUBLIC_API_URL="http://localhost:3000"
NODE_ENV="development"

# Application
APP_NAME="InfraScope"
APP_VERSION="1.0.0"

# Optional: WebSocket configuration
NEXT_PUBLIC_WS_URL="ws://localhost:3000"

# Logging
LOG_LEVEL="info"

# NMS Integration (Network Monitoring System backend)
# External port exposed by NMS docker-compose (4001 → 3001 internal)
NMS_BACKEND_URL="http://localhost:4001"
