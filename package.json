{
  "name": "infrascope",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TURBOPACK=1 next dev --turbo -p ${PORT:-3000}",
    "dev:with-startup": "NEXT_TURBOPACK=1 next dev --turbo -p ${PORT:-3000} & ./scripts/dev-startup.sh",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "db:studio": "prisma studio",
    "license:create": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/license/create-license.ts",
    "deploy:package:customer": "bash scripts/package-customer-deploy.sh",
    "deploy:package:appliance": "bash scripts/package-appliance-assets.sh",
    "security:tls-check": "node scripts/check-production-tls.js"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@react-three/drei": "^9.121.0",
    "@react-three/fiber": "^8.17.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "axios": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "downloadjs": "^1.4.7",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.3",
    "lucide-react": "^0.562.0",
    "next": "^14.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.4.0",
    "prisma": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-toastify": "^11.0.5",
    "reactflow": "^11.11.4",
    "recharts": "^3.7.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.170.0",
    "undici": "^6.26.0",
    "ws": "^8.14.0",
    "zod": "^4.4.3",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@prisma/internals": "^5.0.0",
    "@types/downloadjs": "^1.4.6",
    "@types/node": "20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/three": "^0.170.0",
    "cross-env": "^10.1.0",
    "sharp": "^0.34.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
