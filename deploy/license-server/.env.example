# InfraScope Central License Server Configuration
#
# This file is for the InfraScope operator only. Do not include it in
# customer on-premise deployment packages.

# Public URL for the central license server.
APP_URL=https://lisans.webmahsul.com.tr
NEXTAUTH_URL=https://lisans.webmahsul.com.tr
APP_PORT=3000
APP_NAME=InfraScope License Server

# Deployment role. These values enable the license issuer endpoints.
DEPLOYMENT_MODE=license-server
LICENSE_SERVER_MODE=true

# Existing PostgreSQL server.
# If PostgreSQL is installed on the same VPS, use host.docker.internal after
# enabling PostgreSQL to listen on the Docker host interface.
DB_HOST=host.docker.internal
DB_PORT=5432
POSTGRES_USER=infrascope_license
POSTGRES_PASSWORD=
POSTGRES_DB=infrascope_license
DATABASE_URL=postgresql://infrascope_license:<strong-password>@host.docker.internal:5432/infrascope_license?schema=public

# Secrets. Generate unique strong values before production use.
NEXTAUTH_SECRET=
LICENSE_JWT_SECRET=

# Container image source. Pin VERSION for production.
REGISTRY=ghcr.io/celebigilfatih
VERSION=1.0.0
