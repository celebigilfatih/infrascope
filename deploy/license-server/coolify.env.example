# InfraScope Central License Server - Coolify Environment
#
# Use this in https://coolify.webmahsul.com.tr for the license-server resource.
# Replace PostgreSQL values with the internal connection values from your
# Coolify PostgreSQL resource.

APP_URL=https://lisans.webmahsul.com.tr
NEXTAUTH_URL=https://lisans.webmahsul.com.tr
APP_PORT=3000
APP_NAME=InfraScope License Server

DEPLOYMENT_MODE=license-server
LICENSE_SERVER_MODE=true

# Coolify PostgreSQL resource internal connection.
# Typical DB_HOST is the PostgreSQL service/resource name shown by Coolify.
DB_HOST=<coolify-postgres-internal-host>
DB_PORT=5432
POSTGRES_USER=<postgres-user>
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=<postgres-database>
DATABASE_URL=postgresql://<postgres-user>:<postgres-password>@<coolify-postgres-internal-host>:5432/<postgres-database>?schema=public

NEXTAUTH_SECRET=<openssl-rand-base64-32>
LICENSE_JWT_SECRET=<openssl-rand-base64-32>

REGISTRY=ghcr.io/celebigilfatih
VERSION=1.0.0
