#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${INFRASCOPE_HOME:-/opt/infrascope}"
TARGET_VERSION="${1:-}"

if [ "$(id -u)" -ne 0 ]; then
  echo "Please run with sudo: sudo infrascope-update <version>" >&2
  exit 1
fi

if [ -z "${TARGET_VERSION}" ]; then
  echo "Usage: sudo infrascope-update <version>" >&2
  echo "Example: sudo infrascope-update 1.0.1" >&2
  exit 1
fi

if [ ! -d "${APP_DIR}" ]; then
  echo "InfraScope appliance directory not found: ${APP_DIR}" >&2
  exit 1
fi

cd "${APP_DIR}"

if [ ! -x ./update.sh ]; then
  chmod +x ./update.sh
fi

./update.sh "${TARGET_VERSION}"

