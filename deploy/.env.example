# InfraScope On-Premise Deployment Configuration

# License key provided by InfraScope.
LICENSE_KEY=
LICENSE_SERVER_URL=https://lisans.webmahsul.com.tr

# Database. POSTGRES_PASSWORD is generated by install.sh.
POSTGRES_USER=infrascope
POSTGRES_PASSWORD=
POSTGRES_DB=infrascope

# Application URL and exposed port.
APP_URL=http://localhost:8170
APP_PORT=8170
APP_NAME=InfraScope
NEXTAUTH_URL=http://localhost:8170

# Session secret. Generated by install.sh.
NEXTAUTH_SECRET=

# Container image source. Pin VERSION for customer installs.
REGISTRY=ghcr.io/celebigilfatih
VERSION=1.0.0

# Optional isolated Docker project name when sharing a host. Keep it stable after installation.
# COMPOSE_PROJECT_NAME=customer-company
NMS_BACKUP_WORKERS=2
DB_BACKUP_INTERVAL_SECONDS=86400
DB_BACKUP_RETENTION_DAYS=14

# Optional network monitoring defaults.
SNMP_COMMUNITY=public
POLL_INTERVAL=60

# Optional CA certificate paths for self-signed FortiAnalyzer/FortiGate/vCenter certificates.
# Place certificates under ./certs on the host; they are mounted read-only at /app/certs.
FORTIANALYZER_TLS_CA_CERT_PATH=
FORTIGATE_TLS_CA_CERT_PATH=
VMWARE_TLS_CA_CERT_PATH=
