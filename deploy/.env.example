# =============================================================================
# InfraScope On-Premise Deployment Configuration
# =============================================================================
# Copy this file to .env and configure with your license key
# =============================================================================

# ── License Configuration (REQUIRED) ─────────────────────────────────────────
# Your license key (format: IS-YYYY-XXXX-XXXX)
# Contact sales@infrascope.com to obtain a license
LICENSE_KEY=

# License server URL (default: https://license.infrascope.com)
LICENSE_SERVER_URL=https://license.infrascope.com

# ── Database Configuration ───────────────────────────────────────────────────
POSTGRES_USER=infrascope
POSTGRES_PASSWORD=infrascope-prod
POSTGRES_DB=infrascope
POSTGRES_PORT=5432

# ── Application Configuration ────────────────────────────────────────────────
# Port to expose the application
APP_PORT=3000

# Application name (displayed in UI)
APP_NAME=InfraScope

# Public URL for authentication callbacks
NEXTAUTH_URL=http://localhost:3000

# Secret for session encryption (generate a random string)
NEXTAUTH_SECRET=change-me-to-a-random-string

# ── Docker Registry ──────────────────────────────────────────────────────────
# Container registry for InfraScope images
REGISTRY=registry.infrascope.com

# Application version
VERSION=latest

# ── Network Monitoring (Optional) ────────────────────────────────────────────
# SNMP community string for network device polling
SNMP_COMMUNITY=public

# Polling interval in seconds
POLL_INTERVAL=60
