<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.infrascope.snmp-host-poller</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/celebigil/Dev/infrascope/scripts/snmp_host_poller_daemon.sh</string>
    </array>

    <!-- Start immediately and keep alive -->
    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Restart after 10s if crashed -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/celebigil/Dev/infrascope/logs/snmp-host-poller.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/celebigil/Dev/infrascope/logs/snmp-host-poller.log</string>
</dict>
</plist>
